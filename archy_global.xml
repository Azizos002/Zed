<mxfile host="app.diagrams.net">
  <diagram name="CyberDefense Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TRAFFIC -->
        <mxCell id="traffic" value="Trafic Réseau" style="shape=ellipse;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- SURICATA -->
        <mxCell id="suricata" value="Suricata (IDS)" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="200" y="250" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- LOG PIPELINE -->
        <mxCell id="filebeat" value="Filebeat" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="400" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="logstash" value="Logstash" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="550" y="150" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="elastic" value="Elasticsearch" style="rounded=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- FEATURE -->
        <mxCell id="features" value="Feature Extraction" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="900" y="150" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- AI -->
        <mxCell id="ai" value="LSTM-VAE (AI)" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="1100" y="150" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- DECISION -->
        <mxCell id="decision" value="Moteur de Décision" style="rounded=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1300" y="250" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- RESPONSE -->
        <mxCell id="response" value="Réponse Automatique&#10;(Block / Limit / Alert)" style="rounded=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="1550" y="250" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- LEARNING -->
        <mxCell id="learning" value="Apprentissage &amp; Réentraînement" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="900" y="350" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- THREAT INTEL -->
        <mxCell id="intel" value="Threat Intelligence" style="rounded=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="1150" y="350" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- AWARENESS -->
        <mxCell id="awareness" value="Prévention &amp; Sensibilisation" style="rounded=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="1350" y="350" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- EDGES -->
        <mxCell edge="1" source="traffic" target="suricata" parent="1"/>
        <mxCell edge="1" source="suricata" target="filebeat" parent="1"/>
        <mxCell edge="1" source="filebeat" target="logstash" parent="1"/>
        <mxCell edge="1" source="logstash" target="elastic" parent="1"/>
        <mxCell edge="1" source="elastic" target="features" parent="1"/>
        <mxCell edge="1" source="features" target="ai" parent="1"/>
        <mxCell edge="1" source="ai" target="decision" parent="1"/>
        <mxCell edge="1" source="decision" target="response" parent="1"/>

        <!-- FEEDBACK -->
        <mxCell edge="1" source="response" target="learning" parent="1"/>
        <mxCell edge="1" source="learning" target="ai" parent="1"/>
        <mxCell edge="1" source="intel" target="learning" parent="1"/>
        <mxCell edge="1" source="learning" target="awareness" parent="1"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>